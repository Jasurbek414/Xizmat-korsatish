# Misc
.DS_Store
*.pem
*.log
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# MUHIM (auditda topilgan xavf): yuqoridagi ".env" namunasi FAQAT aynan ".env"
# nomini qamrab oladi. Parol/token almashtirilganda ".env.bak", ".env.old",
# ".env.2026-07-30" kabi zaxira nusxalar yaratish juda keng tarqalgan amaliyot -
# ular esa e'tiborsiz QOLDIRILMAY, "git add ." bilan JWT_SECRET, Cloudflare
# tunnel tokeni, ARI va SIP parollari bilan birga repozitoriyga tushib ketardi.
.env.bak*
.env.old*
.env.*.bak
.env.backup*

# Asterisk - haqiqiy UzTelecom trunk paroli va ARI paroli shu fayllarda ochiq
# matnda saqlanadi (.env kabi) - faqat *.conf.example namunalari git'ga tushadi.
asterisk-config/pjsip.conf
asterisk-config/ari.conf
# AsteriskTrunkConfigWriter/AsteriskExtensionConfigWriter (backend) yozadigan
# haqiqiy trunk/operator parollari - _placeholder.conf'dan tashqari hammasi.
asterisk-config/pjsip.d/*.conf
!asterisk-config/pjsip.d/_placeholder.conf

# Kutish musiqasi (music-on-hold) audio fayllari. Git kod uchun, media uchun
# emas - audio har commit'da repo tarixiga yopishib qoladi va uni keyin olib
# tashlash qiyin.
# DEPLOY: fayl yo'qolmaydi - scripts/generate-moh.py uni qayta yaratadi
# (qo'llanma: asterisk-config/MOH-QOLLANMA.md).
# DIQQAT: bu papkaga AUDIODAN BOSHQA hech narsa qo'ymang. Asterisk papkadagi
# HAMMA faylni ijro etiladigan deb hisoblaydi - README.md shu yerda turganda
# uni ham "File: .../README" deb ro'yxatga olgan edi (jonli kuzatilgan).
# Shu sababli qo'llanma papkadan tashqariga chiqarildi.
asterisk-config/moh/*
!asterisk-config/moh/.gitkeep

npm-debug.log*
yarn-debug.log*
yarn-error.log*
